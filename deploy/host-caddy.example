# Reference only: scripts/deploy-remote.sh writes this block into the host's shared
# /etc/caddy/Caddyfile itself (between PDFCLAUDEASSISTANT markers) when PCA_DOMAIN is
# set, validates the file and reloads Caddy. Never overwrite the shared Caddyfile.
#
# - Everything (web app, API and the /ws/chat WebSocket) goes to the app, which
#   listens only on 127.0.0.1:PORT (8004 by default).
# - Caddy keeps the Host header, which the WebSocket origin check relies on, passes
#   WebSockets through and sets no request body limit (uploads come in 32 MiB chunks).
# - Behind Cloudflare in Flexible mode, prefix the site with http:// (Cloudflare
#   terminates HTTPS); with "Full (strict)" or no Cloudflare, leave it out and Caddy
#   gets a certificate.

http://<APP_DOMAIN> {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy 127.0.0.1:8004
}
