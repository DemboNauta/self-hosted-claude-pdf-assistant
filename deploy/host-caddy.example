# PdfClaudeAssistant behind the Caddy that already runs on the VPS (outside Docker).
# Paste this block into the host Caddyfile (usually /etc/caddy/Caddyfile), replace
# <APP_DOMAIN> and, if APP_PORT in .env is not 3000, the port. Then reload Caddy:
#   caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# - Everything (web app, API and the /ws/chat WebSocket) goes to the one container,
#   which listens only on 127.0.0.1:APP_PORT.
# - Caddy keeps the Host header, which the WebSocket origin check relies on, passes
#   WebSockets through and sets no request body limit (uploads come in 32 MiB chunks).
# - Behind Cloudflare (proxied), use SSL/TLS mode "Full (strict)": Caddy still gets a
#   real certificate for <APP_DOMAIN>.

<APP_DOMAIN> {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy 127.0.0.1:3000
}
