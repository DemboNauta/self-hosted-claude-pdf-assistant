# PdfClaudeAssistant configuration. Copy to .env and fill in.
#
# Claude runs ONLY through your Claude subscription (Pro/Max) via Claude Code.
# Never add an Anthropic API key here: the server refuses to start if one is set.

# Host port the app listens on (bound to 127.0.0.1; your reverse proxy points here).
APP_PORT=3000

# Only for the optional bundled Caddy (compose profile "caddy"): public domain.
DOMAIN=localhost

# Login password hash. Generate with:
#   docker compose run --rm --no-deps server node dist/hash-password.js 'your password'
# Keep the single quotes: the hash contains `$`.
APP_PASSWORD_HASH=''

# Random secret (>= 32 chars) used to sign the session cookie: openssl rand -hex 32
SESSION_SECRET=

# Subscription token from `claude setup-token` (recommended). Leave empty if you
# log in interactively instead: docker compose exec server claude  ->  /login
CLAUDE_CODE_OAUTH_TOKEN=

# Claude model alias or ID (optional; empty = Claude Code default).
CLAUDE_MODEL=

# Max upload size in MB. 0 = unlimited.
MAX_UPLOAD_MB=0

# Tesseract languages for OCR of scanned PDFs.
OCR_LANGS=spa+eng
