# Optional bundled Caddy (compose profile "caddy") for hosts without their own proxy.
# On a VPS that already runs Caddy, use deploy/host-caddy.example instead.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Everything (web app, API, WebSocket) is served by the app container.
	# No request body limit: uploads are streamed in chunks.
	reverse_proxy server:3000
}
